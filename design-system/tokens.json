{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "name": "ToolsPharma Design System",
  "version": "1.0.0",
  "source": "MANUAL_DE_MARCA_-_TOOLSPHARMA.pdf",
  "color": {
    "brand": {
      "firefly": { "hex": "#12353B", "rgb": [18, 53, 59], "cmyk": [69, 10, 0, 77], "pantone": "7477 C" },
      "genoa": { "hex": "#157572", "rgb": [21, 117, 114], "cmyk": [82, 0, 3, 54], "pantone": "7717 C" },
      "robinsEggBlue": { "hex": "#00C7D4", "rgb": [0, 199, 212], "cmyk": [100, 6, 0, 17], "pantone": "7466 C" },
      "cuttySark": { "hex": "#4E7A78", "rgb": [78, 122, 120], "cmyk": [36, 6, 0, 52], "pantone": "5483 C" },
      "plantation": { "hex": "#234544", "rgb": [35, 69, 68], "cmyk": [49, 0, 1, 73], "pantone": "626 C" },
      "jade": { "hex": "#00A972", "rgb": [0, 169, 114], "cmyk": [100, 0, 33, 34], "pantone": "339 C" },
      "magicMint": { "hex": "#8CEEB4", "rgb": [140, 238, 180], "cmyk": [41, 0, 24, 7], "pantone": "7478 C" }
    },
    "gradient": {
      "brand": { "from": "#12353B", "to": "#009FA9", "angle": 60 }
    },
    "primary": {
      "50": "#EDFBFC", "100": "#D1F5F7", "200": "#A6EBF0", "300": "#73E0E7", "400": "#40D5DF",
      "500": "#00C7D4", "600": "#0A9EA3", "700": "#157572", "800": "#145556", "900": "#12353B"
    },
    "success": {
      "50": "#EAFCF2", "100": "#D1F8E1", "200": "#B4F4CE", "300": "#8CEEB4", "400": "#54D29A",
      "500": "#31C189", "600": "#00A972", "700": "#107C5D", "800": "#234544", "900": "#186352"
    },
    "neutral": {
      "0": "#FFFFFF", "50": "#F8FAFA", "100": "#EDF2F2", "200": "#D8E2E1", "300": "#BCCCCC",
      "400": "#9EB6B5", "500": "#7A9B9A", "600": "#4E7A78", "700": "#2A5153", "800": "#12353B", "900": "#0F2D32"
    },
    "note": "primary/success/neutral são escalas de UI derivadas por interpolação HSL a partir dos hex oficiais do manual (âncoras exatas: primary.500/700/900, success.300/600/800, neutral.0/600/800). Erro/aviso não são definidos no manual — mantidos como tokens técnicos neutros de sistema.",
    "system": {
      "negative": { "50": "#FBEAEA", "500": "#D64545", "600": "#B23333" },
      "warning": { "500": "#C8933A" }
    }
  },
  "typography": {
    "families": {
      "display": { "name": "Bebas Neue", "role": "títulos grandes, hero, números de destaque", "weights": ["thin", "light", "book", "regular", "bold"], "source": "Google Fonts" },
      "body": { "name": "DM Sans", "role": "UI, texto de interface, botões, labels", "weights": ["regular", "italic", "medium", "medium italic", "bold", "bold italic"], "source": "Google Fonts" },
      "data": { "name": "Roboto", "role": "tabelas densas, dados tabulares, texto auxiliar", "weights": ["thin", "light", "regular", "medium", "bold", "black", "condensed", "condensed italic", "bold condensed", "bold condensed italic"], "source": "Google Fonts" },
      "editorial": { "name": "DM Serif", "role": "destaques editoriais, citações, títulos institucionais", "weights": ["regular", "italic"], "source": "Google Fonts" }
    },
    "scale": {
      "xs": "12px", "sm": "14px", "base": "16px", "md": "18px", "lg": "22px",
      "xl": "28px", "2xl": "36px", "3xl": "48px", "4xl": "64px"
    }
  },
  "space": {
    "0": "0px", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
    "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px"
  },
  "radius": {
    "sm": "6px", "md": "8px", "lg": "12px", "xl": "16px", "full": "9999px"
  },
  "logo": {
    "symbol": "hexágono com o monograma 'tp' (iniciais de Tools Pharma)",
    "safeArea": "altura da letra 't' do símbolo, em todos os lados",
    "minSize": { "isolatedSymbol": "1.5cm", "horizontalLockup": "2cm" },
    "variants": ["color", "white", "blackink"],
    "lockups": ["symbol", "wordmark", "lockup-horizontal", "lockup-vertical"],
    "doNot": [
      "não recolorir fora da paleta oficial",
      "não distorcer/esticar",
      "não aplicar sobre fundos de baixo contraste",
      "não usar em tamanho abaixo do mínimo (perde legibilidade)"
    ]
  }
}
